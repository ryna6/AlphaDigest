{
  "name": "marketrecap",
  "version": "0.1.0",
  "private": true,
  "description": "A Netlify-ready market intelligence dashboard for compact market analytics, source coverage, and cross-asset monitoring.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "fetch:uw-earnings": "tsx scripts/fetchUnusualWhalesEarnings.ts",
    "test": "npm run typecheck && tsx --test test/*.test.ts",
    "validate:news-calendar": "sucrase-node scripts/validateNewsCalendarUi.tsx",
    "backfill:futures-candles": "tsx scripts/backfillUnusualWhalesFuturesCandles.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "@tanstack/react-table": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "lucide-react": "latest",
    "next": "14.2.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "zod": "latest",
    "lightweight-charts": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.23",
    "postcss": "^8.4.49",
    "prettier": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "latest",
    "tsx": "latest",
    "sucrase": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
